{
	"name": "Binaryfile",
	"properties": {
		"linkedServiceName": {
			"referenceName": "LS_ADLS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"table_name": {
				"type": "string",
				"defaultValue": "Customers"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@{dataset().table_name}.utcNow()",
					"type": "Expression"
				},
				"folderPath": "output",
				"fileSystem": "demo-container"
			}
		}
	}
}